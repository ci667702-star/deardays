# ───────────── Docker Compose 용 환경변수 ─────────────
# 이 파일을 .env 로 복사해 값을 채운 뒤 `docker compose up -d --build`
#   cp .env.example .env
# 값 만들기 예: openssl rand -hex 24
# 값에 $ # 공백 이 들어가면 작은따옴표로 감싸세요. 예: RDB_PASSWORD='my$pass word'

# MySQL 데이터베이스 이름과 앱이 쓰는 계정 (비워 두면 둘 다 deardays)
# RDB_USERNAME 에 root 는 쓸 수 없어요. (MySQL 이미지가 거부합니다. root 비밀번호는 아래 RDB_ROOT_PASSWORD)
RDB_DATABASE=deardays
RDB_USERNAME=deardays

# 앱 계정 비밀번호 / MySQL root 비밀번호 (필수, 처음 실행할 때 MySQL 에 저장됨)
RDB_PASSWORD=
RDB_ROOT_PASSWORD=

# 로그인 토큰 서명 키 (필수, 32자 이상. 예: openssl rand -hex 48)
JWT_SECRET=

# 관리자 비밀번호 (선택, 8자 이상). 앱의 '오늘의 주제' 창에서 [관리자 모드...]를 누르고
# 이 값을 넣으면 그 계정이 오늘의 주제를 넣고 고칠 수 있어요. 비워 두면 관리자 기능이 꺼져요.
ADMIN_PASSWORD=

# 브라우저로 접속할 포트 (비워 두면 80. 이미 쓰고 있으면 8080 등으로)
# 앞에 HTTPS 프록시를 둘 때는 127.0.0.1:8080 처럼 적어 서버 안에서만 열리게 한다.
WEB_PORT=80

# 사람들이 접속하는 주소 (예: http://school-server.ac.kr:8080)
PUBLIC_URL=http://localhost

# 로그인 실패·회원가입 시도 제한 (IP당 15분, 비워 두면 30)
AUTH_RATE_LIMIT=30

# 앞에 있는 프록시 수. 그대로 1. 학교 웹 서버나 Caddy 같은 HTTPS 프록시를 앞에 하나 더 두면 2.
TRUST_PROXY=1
