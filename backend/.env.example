# ───────────── DearDays 백엔드 환경변수 예시 ─────────────
# `npm run setup:env` 를 실행하면 이 파일을 backend/.env 로 복사하고 JWT_SECRET 을 채워 줍니다.

# MySQL 접속 정보: mysql://사용자:비밀번호@호스트:포트/데이터베이스
# YOUR_MYSQL_PASSWORD 를 MySQL 비밀번호로 바꾸세요. 데이터베이스(deardays)는 마이그레이션이 없으면 만들어 줍니다.
# 비밀번호에 @ : / # % 같은 특수문자가 있으면 URL 인코딩해야 합니다. (예: @ → %40, # → %23)
# 전용 계정을 만들었다면 root 대신 그 계정을 적으세요. (README 참고)
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/deardays"

# JWT 서명 키: 32자 이상의 임의 문자열 (setup:env 가 자동으로 채움)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# API 서버 포트 (바꾸면 frontend/vite.config.js 의 proxy 주소도 같이 바꿔 주세요)
PORT=4000

# CORS 허용 출처 (여러 개면 쉼표로 구분)
CLIENT_ORIGIN="http://localhost:5173"

# 업로드 이미지 저장 폴더 (backend/ 기준 상대 경로)와 한 장당 최대 크기(MB)
UPLOAD_DIR="uploads"
MAX_IMAGE_SIZE_MB=5

# 로그인 실패·회원가입 시도 제한 (IP당 15분 동안 허용 횟수)
AUTH_RATE_LIMIT=30
