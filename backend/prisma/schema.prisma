// DearDays 데이터베이스 스키마 (MySQL)
// 테이블 이름은 snake_case 복수형으로 매핑한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(191)
  password          String    @db.VarChar(255)
  nickname          String    @db.VarChar(30)
  profileImage      String?   @db.VarChar(255)
  introduction      String?   @db.VarChar(300)
  // 비밀번호를 바꾸면 이 시각 이전에 발급된 로그인 토큰은 모두 무효
  passwordChangedAt DateTime?
  // 관리자: 서버에 정한 관리자 비밀번호(ADMIN_PASSWORD)를 입력하면 켜진다. '오늘의 주제'를 관리한다.
  isAdmin           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships         DiaryRoomMember[]
  diaries             Diary[]
  comments            Comment[]
  likes               Like[]
  todosCreated        Todo[]            @relation("TodoCreator")
  todosAssigned       Todo[]            @relation("TodoAssignee")
  todosCompleted      Todo[]            @relation("TodoCompleter")
  notifications       Notification[]    @relation("NotificationRecipient")
  notificationsCaused Notification[]    @relation("NotificationActor")
  lettersSent         Letter[]          @relation("LetterSender")
  lettersReceived     Letter[]          @relation("LetterRecipient")
  stamps              Stamp[]
  topicsCreated       DailyTopic[]
  anniversaries       Anniversary[]
  pushSubscriptions   PushSubscription[]
  inquiries           Inquiry[]

  @@map("users")
}

model DiaryRoom {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(40)
  inviteCode String   @unique @db.VarChar(16)
  createdAt  DateTime @default(now())

  members       DiaryRoomMember[]
  diaries       Diary[]
  todos         Todo[]
  notifications Notification[]
  letters       Letter[]
  anniversaries Anniversary[]

  @@map("diary_rooms")
}

model DiaryRoomMember {
  id          Int      @id @default(autoincrement())
  userId      Int
  diaryRoomId Int
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaryRoom DiaryRoom @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)

  // 한 사용자는 같은 공간에 한 번만 참여할 수 있다.
  @@unique([userId, diaryRoomId])
  @@index([diaryRoomId])
  @@map("diary_room_members")
}

model Diary {
  id          Int      @id @default(autoincrement())
  diaryRoomId Int
  authorId    Int
  title       String   @db.VarChar(100)
  content     String   @db.Text
  diaryDate   DateTime @db.Date
  // 기분(happy/excited/calm/sad/angry)과 날씨(sunny/cloudy/rainy/snowy/windy), 선택
  mood        String?  @db.VarChar(16)
  weather     String?  @db.VarChar(16)
  // 낙서 창에서 그린 그림 (일기 한 편에 하나, 선택)
  doodleUrl   String?  @db.VarChar(255)
  // '오늘의 주제'로 쓴 일기면 그 주제 (주제가 지워지면 비워짐)
  topicId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  diaryRoom     DiaryRoom      @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic         DailyTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  images        DiaryImage[]
  comments      Comment[]
  likes         Like[]
  stamps        Stamp[]
  notifications Notification[]

  @@index([diaryRoomId, diaryDate])
  @@index([authorId])
  @@index([topicId])
  @@map("diaries")
}

model DiaryImage {
  id        Int      @id @default(autoincrement())
  diaryId   Int
  imageUrl  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@map("diary_images")
}

// 댓글. parentId 가 있으면 그 댓글에 단 답글 (한 단계만: 답글의 답글도 맨 위 댓글 아래에 붙는다)
model Comment {
  id        Int       @id @default(autoincrement())
  diaryId   Int
  userId    Int
  parentId  Int?
  content   String    @db.VarChar(500)
  // 얼굴 이모티콘 (config/constants.js 의 COMMENT_FACES). 얼굴만 달고 글은 비워도 된다.
  face      String?   @db.VarChar(16)
  // 답글이 달린 댓글을 지우면 자리만 남긴다 ("삭제된 댓글이에요"). 답글이 없으면 바로 지운다.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  diary   Diary     @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([diaryId, createdAt])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        Int      @id @default(autoincrement())
  diaryId   Int
  userId    Int
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 같은 사용자가 같은 일기에 두 번 공감할 수 없다.
  @@unique([diaryId, userId])
  @@index([userId])
  @@map("likes")
}

// 도장: 친구 일기에 '참 잘했어요' 같은 도장을 찍는다. 한 사람이 같은 일기에 같은 도장은 한 번만.
// kind: great, wow, lol, pat, same, best (backend/src/config/constants.js 의 STAMP_KINDS)
model Stamp {
  id        Int      @id @default(autoincrement())
  diaryId   Int
  userId    Int
  kind      String   @db.VarChar(16)
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([diaryId, userId, kind])
  @@index([userId])
  @@map("stamps")
}

// 오늘의 주제: 관리자가 날짜마다 하나씩 넣어 두면 모든 공간에 그날의 글감으로 보인다.
// 관리자가 넣지 않은 날은 서버에 들어 있는 글감 목록에서 하나를 골라 자동으로 만든다(isAuto).
model DailyTopic {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  content     String   @db.VarChar(200)
  isAuto      Boolean  @default(false)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  diaries   Diary[]

  @@index([createdById])
  @@map("daily_topics")
}

// 기념일: 생일·시험·여행 같은 날. 공간 사람 모두에게 보이고, 해마다 반복할 수 있다(yearly).
model Anniversary {
  id          Int      @id @default(autoincrement())
  diaryRoomId Int
  creatorId   Int
  title       String   @db.VarChar(40)
  date        DateTime @db.Date
  yearly      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  diaryRoom DiaryRoom @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([diaryRoomId, date])
  @@index([creatorId])
  @@map("anniversaries")
}

// 휴대폰·브라우저 푸시 알림 구독 (기기마다 하나). endpoint 가 길어서 같은 기기 확인은 해시로 한다.
model PushSubscription {
  id           Int      @id @default(autoincrement())
  userId       Int
  endpoint     String   @db.VarChar(1000)
  endpointHash String   @unique @db.Char(64)
  p256dh       String   @db.VarChar(255)
  auth         String   @db.VarChar(255)
  userAgent    String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// 공유 공간의 '우리 할 일' 목록. 두 사람 모두 추가하고 완료 표시할 수 있다.
model Todo {
  id            Int       @id @default(autoincrement())
  diaryRoomId   Int
  creatorId     Int
  // 맡은 사람. 비어 있으면 '함께' 하는 일
  assigneeId    Int?
  completedById Int?
  content       String    @db.VarChar(200)
  isDone        Boolean   @default(false)
  dueDate       DateTime? @db.Date
  doneAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  diaryRoom   DiaryRoom @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)
  creator     User      @relation("TodoCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy User?     @relation("TodoCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([diaryRoomId, isDone])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([completedById])
  @@map("todos")
}

// 새 소식 알림. 받는 사람(recipient)마다 한 줄씩 만든다.
// type: DIARY_CREATED, COMMENT_CREATED, COMMENT_REPLIED, LIKE_CREATED, STAMP_CREATED, TODO_ASSIGNED, MEMBER_JOINED,
//       LETTER_SENT, LETTER_ARRIVED, LETTER_OPENED
model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  actorId     Int?
  diaryRoomId Int
  type        String   @db.VarChar(32)
  diaryId     Int?
  letterId    Int?
  // 알림을 만들 때의 짧은 내용 (일기 제목, 댓글 앞부분 등)
  preview     String?  @db.VarChar(120)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  recipient User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  diaryRoom DiaryRoom @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)
  diary     Diary?    @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  letter    Letter?   @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@index([actorId])
  @@index([diaryRoomId])
  @@index([diaryId])
  @@index([letterId])
  @@map("notifications")
}

// 타임캡슐 편지: openAt 날짜가 되기 전에는 받는 사람이 내용을 볼 수 없다.
model Letter {
  id              Int       @id @default(autoincrement())
  diaryRoomId     Int
  senderId        Int
  // 받는 사람은 공간의 멤버 (나 자신에게 보내는 것도 가능)
  recipientId     Int
  title           String    @db.VarChar(60)
  content         String    @db.Text
  openAt          DateTime  @db.Date
  openedAt        DateTime?
  arrivalNotified Boolean   @default(false)
  createdAt       DateTime  @default(now())

  diaryRoom     DiaryRoom      @relation(fields: [diaryRoomId], references: [id], onDelete: Cascade)
  sender        User           @relation("LetterSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User           @relation("LetterRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([diaryRoomId])
  @@index([senderId])
  @@index([recipientId, openAt])
  @@map("letters")
}

// 문의: 사용자가 '내 정보'에서 보내고, 관리자가 '관리자' 화면의 문의함에서 읽고 답한다.
// 탈퇴하면 그 사람의 문의도 함께 지워진다.
model Inquiry {
  id         Int       @id @default(autoincrement())
  userId     Int
  // bug(오류 신고) | idea(기능 제안) | account(계정) | etc(기타)
  category   String    @db.VarChar(16)
  content    String    @db.Text
  // open(아직 확인 전) | done(처리함)
  status     String    @default("open") @db.VarChar(16)
  answer     String?   @db.Text
  answeredAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("inquiries")
}
