# ───────────── Docker Compose 용 환경변수 ─────────────
# 이 파일을 .env 로 복사해 값을 채운 뒤 `docker compose up -d --build`
#   cp .env.example .env
# 값 만들기 예: openssl rand -hex 24   (영문·숫자만 나와서 URL 에 넣어도 안전)

# MySQL root 비밀번호 / 앱이 쓰는 deardays 계정 비밀번호
# DB_PASSWORD 는 DB 접속 주소(URL)에 들어가므로 영문과 숫자만 쓰세요.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# 로그인 토큰 서명 키 (32자 이상, 예: openssl rand -hex 48)
JWT_SECRET=

# 브라우저로 접속할 포트 (80 을 이미 쓰고 있으면 8080 등으로)
WEB_PORT=80

# 사람들이 접속하는 주소 (예: http://school-server.ac.kr:8080)
PUBLIC_URL=http://localhost

# 로그인 실패·회원가입 시도 제한 (IP당 15분)
AUTH_RATE_LIMIT=30
