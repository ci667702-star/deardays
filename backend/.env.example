# ───────────── DearDays 백엔드 환경변수 예시 ─────────────
# 이 파일을 복사해 backend/.env 로 저장한 뒤 값을 채워 주세요.  (cp .env.example .env)

# MySQL 접속 정보: mysql://사용자:비밀번호@호스트:포트/데이터베이스
# 비밀번호에 @ : / # 같은 특수문자가 있으면 URL 인코딩해야 합니다. (예: @ → %40)
DATABASE_URL="mysql://deardays:change-me@localhost:3306/deardays"

# JWT 서명 키: 32자 이상의 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000

# CORS 허용 출처 (여러 개면 쉼표로 구분)
CLIENT_ORIGIN="http://localhost:5173"

# 업로드 이미지 저장 폴더 (backend/ 기준 상대 경로)와 한 장당 최대 크기(MB)
UPLOAD_DIR="uploads"
MAX_IMAGE_SIZE_MB=5

# 로그인·회원가입 시도 제한 (IP당 15분 동안 허용 횟수)
AUTH_RATE_LIMIT=30
